---
import Base from '../../layouts/Base.astro';
import { approach } from '../../data/site';
import type { Lang } from '../../i18n/config';
import { localeStaticPaths, tr, useTranslations } from '../../i18n/utils';

export const getStaticPaths = localeStaticPaths;

const { lang } = Astro.props as { lang: Lang };
const t = useTranslations(lang);
const [processA, processB] = t('approach.process');
const [aiA, aiB] = t('approach.ai');
---

<Base title={t('approach.title')}>
  <section class="process">
    <h2 class="section-title reveal">{processA} <span>{processB}</span></h2>
    <p class="intro reveal" style="--i:1">{tr(approach.intro, lang)}</p>

    <ol class="steps">
      {
        approach.steps.map((step, i) => (
          <li class="step reveal" style={`--i:${i + 2}`}>
            <span class="num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <div class="step-body">
              <h3>{tr(step.title, lang)}</h3>
              <p>{tr(step.text, lang)}</p>
            </div>
            <div class="chips">
              {step.tags.map((tag) => <span class="chip">{tag}</span>)}
            </div>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="section">
    <h2 class="section-title">{aiA} <span>{aiB}</span></h2>
    <div class="ai">
      {
        approach.ai.map((item) => (
          <div class="ai-card">
            <h3>{tr(item.title, lang)}</h3>
            <p>{tr(item.text, lang)}</p>
          </div>
        ))
      }
    </div>
  </section>
</Base>

<style>
  .process {
    padding-bottom: 64px;
  }
  .intro {
    margin-top: -16px;
    max-width: 620px;
    color: var(--text-2);
  }

  .steps {
    list-style: none;
    margin: 28px 0 0;
    padding: 0;
  }
  .step {
    display: grid;
    grid-template-columns: 56px minmax(0, 1fr) minmax(0, 300px);
    gap: 24px;
    align-items: start;
    padding: 24px 0;
  }
  .step + .step {
    border-top: 1px solid var(--line);
  }
  .num {
    font-size: 28px;
    font-weight: 500;
    line-height: 1;
    color: var(--text-3);
    font-variant-numeric: tabular-nums;
  }
  .step-body h3 {
    font-size: 18px;
    font-weight: 600;
    margin-bottom: 6px;
  }
  .step-body p {
    max-width: 560px;
    color: var(--text-2);
    font-size: 15px;
  }
  .step .chips {
    justify-content: flex-end;
  }

  .section {
    border-top: 1px solid var(--line);
  }
  .ai {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 8px;
  }
  .ai-card {
    padding: 18px;
    border-radius: var(--radius-md);
    background: var(--surface);
  }
  .ai-card h3 {
    font-size: 16px;
    font-weight: 600;
    margin-bottom: 6px;
  }
  .ai-card p {
    font-size: 14px;
    color: var(--text-3);
  }

  @media (max-width: 860px) {
    .step {
      grid-template-columns: 44px minmax(0, 1fr);
      gap: 12px 16px;
    }
    .num {
      font-size: 22px;
    }
    .step .chips {
      grid-column: 2;
      justify-content: flex-start;
    }
    .ai {
      grid-template-columns: 1fr;
    }
  }
</style>
