---
// Главная. Все карточки лежат в одной 12-колоночной сетке с общим gutter:
// крупные (featured: true) — обложка 6 колонок + текст 6 колонок,
// остальные — по 6 колонок, две в ряд. Вертикальный шаг между карточками один.
// «Другие проекты» (архив) встаёт в свободную ячейку, если компактных кейсов
// нечётное число, иначе — плашкой на всю ширину.
import Base from '../../layouts/Base.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import Icon from '../../components/Icon.astro';
import { caseTypes, getCases } from '../../data/cases';
import type { Lang } from '../../i18n/config';
import { localePath, localeStaticPaths, tr, useTranslations } from '../../i18n/utils';

export const getStaticPaths = localeStaticPaths;

const { lang } = Astro.props as { lang: Lang };
const t = useTranslations(lang);
const { featured, rest, archived } = await getCases();
const moreInGrid = archived.length > 0 && rest.length % 2 === 1;
const archiveHref = localePath('/archive/', lang);
---

<Base>
  <!-- Фильтры появляются, только если работает JavaScript. Без него видны все кейсы. -->
  <div class="filters" role="group" aria-label={t('work.filter')} hidden>
    <button type="button" class="filter" data-filter="all" aria-pressed="true">{t('work.all')}</button>
    {
      caseTypes.map((type) => (
        <button type="button" class={`filter type-${type.id}`} data-filter={type.id} aria-pressed="false">
          {tr(type.label, lang)}
        </button>
      ))
    }
  </div>

  <div class="work" aria-label={t('nav.work')} role="region">
    <section class="featured">
      {featured.map((item, i) => <ProjectCard item={item} index={i} layout="row" />)}
    </section>

    <section class="grid">
      {rest.map((item, i) => <ProjectCard item={item} index={i + featured.length} />)}
      {
        moreInGrid && (
          <a href={archiveHref} class="more-card reveal" style={`--i:${rest.length + featured.length}`}>
            <div class="more-cover">
              <ul>
                {archived.map((a) => (
                  <li>{tr(a.data.title, lang)}</li>
                ))}
              </ul>
            </div>
            <div class="more-info">
              <span class="more-title">{t('work.more')}</span>
              <span class="more-text">{t('work.moreText')}</span>
              <span class="more-read">
                {t('work.viewAll')} <Icon name="arrow-up-right" size={14} />
              </span>
            </div>
          </a>
        )
      }
    </section>
  </div>

  {
    archived.length > 0 && !moreInGrid && (
      <a href={archiveHref} class="more">
        <span>
          <span class="more-title">{t('work.more')}</span>
          <span class="more-text">{t('work.moreText')}</span>
        </span>
        <Icon name="arrow-up-right" size={18} />
      </a>
    )
  }
</Base>

<script>
  function initFilters() {
    const bar = document.querySelector<HTMLElement>('.filters');
    if (!bar || bar.dataset.ready) return;
    bar.dataset.ready = '1';
    bar.hidden = false;
    const buttons = bar.querySelectorAll<HTMLButtonElement>('.filter');
    const cards = document.querySelectorAll<HTMLElement>('.work .card[data-types]');
    buttons.forEach((btn) =>
      btn.addEventListener('click', () => {
        const id = btn.dataset.filter ?? 'all';
        buttons.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
        cards.forEach((card) => {
          card.hidden = id !== 'all' && !(card.dataset.types ?? '').split(' ').includes(id);
        });
      }),
    );
  }
  initFilters();
  document.addEventListener('astro:page-load', initFilters);
</script>

<style>
  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-bottom: 28px;
  }
  .filters[hidden] {
    display: none;
  }
  .filter {
    padding: 7px 14px;
    border-radius: 999px;
    background: var(--surface);
    font-size: 13px;
    font-weight: 600;
    color: var(--text-2);
    transition:
      background-color 0.2s,
      color 0.2s;
  }
  .filter:hover {
    background: var(--surface-hover);
    color: var(--text);
  }
  .filter[aria-pressed='true'] {
    background: var(--t-accent, var(--text));
    color: #fff;
  }

  /* Одна сетка для всех карточек: секции берут одинаковые 12 колонок */
  .work {
    --gutter: 24px;
    --card-gap: 48px;
    display: grid;
    gap: var(--card-gap);
    padding-bottom: 64px;
  }
  .featured,
  .grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--gutter);
    row-gap: var(--card-gap);
  }
  .featured:empty {
    display: none;
  }
  /* Компактная карточка — 6 колонок, две строки (обложка + текст), см. ProjectCard */
  .grid > :global(.card),
  .more-card {
    grid-column: span 6;
  }

  /* «Другие проекты» в свободной ячейке сетки — того же размера, что карточки.
     В обложке — только список проектов, заголовок и описание — под ней. */
  .more-card {
    display: grid;
    grid-row: span 2;
    grid-template-rows: subgrid;
    row-gap: 16px;
  }
  .more-cover {
    display: grid;
    align-content: center;
    padding: 32px;
    border-radius: var(--radius-lg);
    background: var(--surface);
    transition: background-color 0.2s;
  }
  .more-card:hover .more-cover {
    background: var(--surface-hover);
  }
  .more-cover ul {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 12px;
  }
  .more-cover li {
    font-size: 20px;
    font-weight: 500;
    line-height: 1.25;
    letter-spacing: -0.005em;
    color: var(--text-2);
  }
  .more-cover li + li {
    padding-top: 12px;
    border-top: 1px solid rgba(4, 17, 31, 0.1);
  }
  .more-info {
    display: grid;
    align-content: start;
    justify-items: start;
    gap: 8px;
  }
  .more-read {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    margin-top: 4px;
    font-size: 14px;
    font-weight: 600;
    color: var(--text-2);
    transition: gap 0.2s var(--ease);
  }
  .more-card:hover .more-read {
    gap: 7px;
    color: var(--text);
  }

  .more {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 64px;
    padding: 20px 24px;
    border-radius: var(--radius-lg);
    background: var(--surface);
    transition: background-color 0.2s;
  }
  .more:hover {
    background: var(--surface-hover);
  }
  .more-title {
    display: block;
    font-size: 20px;
    font-weight: 500;
  }
  .more .more-title {
    font-size: 16px;
    font-weight: 600;
  }
  .more-text {
    display: block;
    font-size: 15px;
    color: var(--text-2);
  }
  .more .more-text {
    margin-top: 2px;
    font-size: 14px;
    color: var(--text-3);
  }

  @media (max-width: 768px) {
    .featured,
    .grid {
      grid-template-columns: minmax(0, 1fr);
    }
    .grid > :global(.card),
    .more-card {
      grid-column: 1 / -1;
    }
  }
</style>
