---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import { resume } from '../../data/site';
import type { Lang } from '../../i18n/config';
import { localeStaticPaths, tr, useTranslations } from '../../i18n/utils';

export const getStaticPaths = localeStaticPaths;

const { lang } = Astro.props as { lang: Lang };
const t = useTranslations(lang);
const [toolsA, toolsB] = t('resume.tools');
---

<Base title={t('resume.title')}>
  <section class="intro reveal">
    <div class="intro-text">
      <h2 class="headline">{tr(resume.title, lang)}</h2>
      <p class="summary">{tr(resume.summary, lang)}</p>
      <div class="chips">{resume.facts.map((f) => <span class="chip">{tr(f, lang)}</span>)}</div>
    </div>
    <a class="download" href={resume.cvUrl} download="Alexander_Edelman_CV.pdf">
      <span class="download-icon"><Icon name="download" size={18} /></span>
      <span>
        <span class="download-title">{t('resume.download')}</span>
        <span class="download-meta">{t('resume.pdf')}</span>
      </span>
    </a>
  </section>

  <section class="section">
    <h2 class="section-title">{t('resume.experience')}</h2>
    {
      resume.experience.map((job, i) => (
        <article class="job reveal" style={`--i:${i + 1}`}>
          <img class="logo" src={job.logo} alt={job.company} width="40" height="40" loading="lazy" />
          <div>
            <h3>{tr(job.role, lang)}</h3>
            <p class="job-meta">
              <span class="company">{job.company}</span> <span class="dot">·</span> {tr(job.period, lang)}{' '}
              <span class="dot">·</span> {tr(job.location, lang)}
            </p>
            <ul class="bullets">
              {tr(job.bullets, lang).map((b) => <li>{b}</li>)}
            </ul>
          </div>
        </article>
      ))
    }
  </section>

  <section class="section">
    <h2 class="section-title">{t('resume.skills')}</h2>
    <div class="chips">{resume.skills.map((s) => <span class="chip">{tr(s, lang)}</span>)}</div>
  </section>

  <section class="section">
    <h2 class="section-title">{toolsA} <span>{toolsB}</span></h2>
    <div class="tools">
      {
        resume.tools.map((tool, i) => (
          <div class="tool">
            <span class="tool-icon" style={`--h:${(i * 53 + 210) % 360}`}>{tool.name.charAt(0)}</span>
            <div>
              <p class="tool-name">{tool.name}</p>
              <p class="tool-use">{tr(tool.use, lang)}</p>
            </div>
          </div>
        ))
      }
    </div>
  </section>

  <section class="section">
    <h2 class="section-title">{t('resume.languages')}</h2>
    <div class="langs">
      {
        resume.languages.map((l) => (
          <div class="lang-item">
            <span class="lang-name">{tr(l.name, lang)}</span>
            <span class="lang-level">{tr(l.level, lang)}</span>
          </div>
        ))
      }
    </div>
  </section>

  {
    resume.awards.length > 0 && (
      <section class="section">
        <h2 class="section-title">{t('resume.awards')}</h2>
        <ul class="list">
          {resume.awards.map((a) => <li><p class="item-title">{tr(a.title, lang)}</p><p class="item-meta">{tr(a.meta, lang)}</p></li>)}
        </ul>
      </section>
    )
  }

  <section class="section">
    <h2 class="section-title">{t('resume.education')}</h2>
    <ul class="list">
      {
        resume.education.map((e) => (
          <li class="edu">
            <img class="logo logo--sm" src={e.logo} alt="" width="32" height="32" loading="lazy" />
            <div>
              <p class="item-title">{tr(e.title, lang)}</p>
              <p class="item-meta">{tr(e.meta, lang)}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </section>
</Base>

<style>
  /* ---------- Вступление и скачивание ---------- */
  .intro {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 32px;
    padding-bottom: 56px;
  }
  .intro-text {
    max-width: 720px;
  }
  .headline {
    font-size: 24px;
    font-weight: 500;
    line-height: 1.25;
  }
  .summary {
    margin: 12px 0 20px;
    color: var(--text-2);
  }
  .download {
    flex: none;
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 18px 12px 12px;
    border-radius: 16px;
    background: var(--text);
    color: var(--bg);
    transition:
      background-color 0.2s,
      transform 0.2s var(--ease);
  }
  .download:hover {
    background: rgba(4, 17, 31, 0.87);
  }
  .download:active {
    transform: scale(0.97);
  }
  .download-icon {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: 10px;
    background: rgba(255, 255, 255, 0.12);
    transition: transform 0.4s var(--spring-bouncy);
  }
  .download:hover .download-icon {
    transform: translateY(2px);
  }
  .download-title {
    display: block;
    font-size: 14px;
    font-weight: 600;
  }
  .download-meta {
    display: block;
    font-size: 12px;
    opacity: 0.6;
  }

  .section {
    border-top: 1px solid var(--line);
  }

  /* ---------- Опыт ---------- */
  .job {
    display: grid;
    grid-template-columns: 40px minmax(0, 1fr);
    gap: 16px;
    padding: 20px 0;
  }
  .job + .job {
    border-top: 1px solid var(--line);
  }
  .job:first-of-type {
    padding-top: 0;
  }
  .logo {
    width: 40px;
    height: 40px;
    padding: 4px;
    border-radius: 11px;
    background: #fff;
    box-shadow: inset 0 0 0 1px var(--line);
    object-fit: contain;
  }
  .logo--sm {
    width: 32px;
    height: 32px;
    padding: 3px;
    border-radius: 9px;
  }
  h3 {
    font-size: 16px;
    font-weight: 600;
    line-height: 1.35;
  }
  .job-meta {
    margin-top: 4px;
    font-size: 13px;
    color: var(--text-3);
  }
  .company {
    color: var(--text);
    font-weight: 600;
  }
  .dot {
    margin-inline: 2px;
  }
  .bullets {
    margin: 12px 0 0;
    padding-left: 18px;
    max-width: 820px;
    display: grid;
    gap: 6px;
    font-size: 15px;
    color: var(--text-2);
  }
  .bullets li::marker {
    color: var(--text-3);
  }

  /* ---------- Инструменты ---------- */
  .tools {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 8px;
  }
  .tool {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px;
    border-radius: var(--radius-md);
    background: var(--surface);
  }
  .tool-icon {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: 10px;
    background: linear-gradient(135deg, hsl(var(--h) 80% 62%), hsl(calc(var(--h) + 30) 80% 50%));
    color: white;
    font-weight: 700;
  }
  .tool-name {
    font-size: 14px;
    font-weight: 600;
  }
  .tool-use {
    font-size: 13px;
    color: var(--text-3);
  }

  /* ---------- Языки ---------- */
  .langs {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 8px;
  }
  .lang-item {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 8px;
    padding: 14px 16px;
    border-radius: var(--radius-md);
    background: var(--surface);
  }
  .lang-name {
    font-size: 14px;
    font-weight: 600;
  }
  .lang-level {
    font-size: 13px;
    color: var(--text-3);
  }

  /* ---------- Образование ---------- */
  .list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .list li {
    padding: 14px 0;
  }
  .list li + li {
    border-top: 1px solid var(--line);
  }
  .edu {
    display: grid;
    grid-template-columns: 32px minmax(0, 1fr);
    gap: 14px;
    align-items: center;
  }
  .item-title {
    font-size: 15px;
    font-weight: 600;
  }
  .item-meta {
    margin-top: 2px;
    font-size: 13px;
    color: var(--text-3);
  }

  @media (max-width: 860px) {
    .intro {
      flex-direction: column;
      gap: 24px;
    }
    .tools,
    .langs {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 480px) {
    .tools {
      grid-template-columns: 1fr;
    }
    .download {
      align-self: stretch;
    }
  }
</style>
