---
import Base from '../../layouts/Base.astro';
import { experiments } from '../../data/site';
import type { Lang } from '../../i18n/config';
import { localeStaticPaths, tr, useTranslations } from '../../i18n/utils';

export const getStaticPaths = localeStaticPaths;

const { lang } = Astro.props as { lang: Lang };
const t = useTranslations(lang);
---

<Base title={t('experiments.title')}>
  <section class="masonry" aria-label={t('experiments.title')}>
    {
      experiments.map((item, i) => (
        <figure class="tile reveal" style={`--i:${i}`}>
          <div
            class="img"
            style={`aspect-ratio:${item.ratio};--a:${item.tint[0]};--b:${item.tint[1]}`}
          >
            {item.image && <img src={item.image} alt={tr(item.title, lang)} loading="lazy" />}
          </div>
          <figcaption>{tr(item.title, lang)}</figcaption>
        </figure>
      ))
    }
  </section>
</Base>

<style>
  .masonry {
    columns: 3;
    column-gap: 24px;
    padding-bottom: 64px;
  }
  .tile {
    break-inside: avoid;
    margin: 0 0 28px;
  }
  .img {
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: linear-gradient(150deg, var(--a), var(--b));
  }
  .img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  figcaption {
    margin-top: 10px;
    font-size: 14px;
    font-weight: 600;
    color: var(--text-3);
  }
  @media (max-width: 860px) {
    .masonry {
      columns: 2;
      column-gap: 16px;
    }
  }
  @media (max-width: 520px) {
    .masonry {
      columns: 1;
    }
  }
</style>
