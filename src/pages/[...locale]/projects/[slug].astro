---
// Шаблон страницы кейса. Разделы идут в фиксированном порядке;
// раздел, которого нет в YAML-файле кейса, не показывается.
import Base from '../../../layouts/Base.astro';
import ProjectCard from '../../../components/ProjectCard.astro';
import CopyEmail from '../../../components/CopyEmail.astro';
import Icon from '../../../components/Icon.astro';
import AtAGlance from '../../../components/case/AtAGlance.astro';
import DecisionCard from '../../../components/case/DecisionCard.astro';
import BeforeAfter from '../../../components/case/BeforeAfter.astro';
import CaseVisual from '../../../components/case/CaseVisual.astro';
import CaseCover from '../../../components/case/CaseCover.astro';
import Prose from '../../../components/case/Prose.astro';
import { getCases, statusLabels, typesOf, type Case } from '../../../data/cases';
import type { Lang } from '../../../i18n/config';
import { localePath, localeStaticPaths, tr, useTranslations } from '../../../i18n/utils';

export async function getStaticPaths() {
  const { all } = await getCases();
  return localeStaticPaths().flatMap(({ params, props }) =>
    all.map((item) => ({
      params: { ...params, slug: item.id },
      props: { ...props, item },
    })),
  );
}

const { item, lang } = Astro.props as { item: Case; lang: Lang };
const d = item.data;
const t = useTranslations(lang);
const title = tr(d.title, lang);
const summary = tr(d.summary, lang);

const glance = [
  { label: t('case.role'), value: tr(d.role, lang) },
  { label: t('case.team'), value: tr(d.team, lang) },
  ...(d.timeline ? [{ label: t('case.timeline'), value: tr(d.timeline, lang) }] : []),
  ...(d.archived ? [] : [{ label: t('case.status'), value: d.status ? tr(statusLabels[d.status], lang) : 'TODO' }]),
  {
    label: t('case.type'),
    value: typesOf(item)
      .map((type) => tr(type.label, lang))
      .join(', '),
  },
];

// «Другие работы»: следующие два кейса из основной подборки
const { main } = await getCases();
const pos = main.findIndex((c) => c.id === item.id);
const more = [1, 2].map((k) => main[(Math.max(pos, -1) + k + main.length) % main.length]).filter((c) => c.id !== item.id);

const decisionLabels = { decision: t('case.decision'), chosen: t('case.chosen'), why: t('case.why') };

// Визуалы раздела: до или после его текста
type Section = Case['data']['visuals'][number]['section'];
const visualsFor = (section: Section, placement: 'before' | 'after') =>
  d.visuals.map((v, i) => ({ v, i })).filter(({ v }) => v.section === section && v.placement === placement);
const has = (section: Section) => d.visuals.some((v) => v.section === section);
---

<Base title={title} description={summary} hero={false}>
  <article class="case">
    <header class="case-head reveal">
      <a href={localePath(d.archived ? '/archive/' : '/', lang)} class="back">
        <Icon name="arrow-left" size={16} />
        {d.archived ? t('archive.title') : t('case.back')}
      </a>
      <p class="eyebrow">{[tr(d.company, lang), d.year].filter(Boolean).join(' • ')}</p>
      <h1>{title}</h1>
      <p class:list={['lead', { todo: summary.includes('TODO') }]}>{summary}</p>
    </header>

    <div class="cover" transition:name={`cover-${item.id}`}>
      {d.cover ? <img src={d.cover} alt={title} /> : <CaseCover item={item} lang={lang} />}
    </div>

    <div class="glance">
      <AtAGlance title={t('case.glance')} items={glance} />
    </div>

    {
      d.overview && (
        <section class="block">
          <h2>{t('case.overview')}</h2>
          <Prose items={tr(d.overview, lang)} />
        </section>
      )
    }

    {
      (d.problem || has('problem')) && (
        <section class="block">
          <h2>{t('case.problem')}</h2>
          {visualsFor('problem', 'before').map(({ v, i }) => <CaseVisual visual={v} lang={lang} id={`${item.id}-${i}`} />)}
          {d.problem && <Prose items={tr(d.problem, lang)} />}
          {visualsFor('problem', 'after').map(({ v, i }) => <div class="after"><CaseVisual visual={v} lang={lang} id={`${item.id}-${i}`} /></div>)}
        </section>
      )
    }

    {
      (d.constraints || has('constraints')) && (
        <section class="block">
          <h2>{t('case.constraints')}</h2>
          {d.constraints && <Prose items={tr(d.constraints, lang)} list />}
          {visualsFor('constraints', 'after').map(({ v, i }) => <div class="after"><CaseVisual visual={v} lang={lang} id={`${item.id}-${i}`} /></div>)}
        </section>
      )
    }

    {
      d.myRole && (
        <section class="block">
          <h2>{t('case.myRole')}</h2>
          <div class="role">
            <div>
              <h3>{t('case.me')}</h3>
              <Prose items={tr(d.myRole.me, lang)} />
            </div>
            {d.myRole.team && (
              <div>
                <h3>{t('case.we')}</h3>
                <Prose items={tr(d.myRole.team, lang)} />
              </div>
            )}
          </div>
        </section>
      )
    }

    {
      (d.decisions || has('decisions')) && (
        <section class="block">
          <h2>{t('case.decisions')}</h2>
          {visualsFor('decisions', 'before').map(({ v, i }) => <div class="before"><CaseVisual visual={v} lang={lang} id={`${item.id}-${i}`} /></div>)}
          {d.decisions && (
            <div class="decisions">
              {d.decisions.map((dec, i) => (
                <DecisionCard
                  index={i}
                  title={tr(dec.title, lang)}
                  options={dec.options.map((o) => tr(o, lang))}
                  chosen={dec.chosen}
                  sketches={dec.sketches}
                  between={dec.between && tr(dec.between, lang)}
                  why={tr(dec.why, lang)}
                  labels={decisionLabels}
                />
              ))}
            </div>
          )}
          {visualsFor('decisions', 'after').map(({ v, i }) => <div class="after"><CaseVisual visual={v} lang={lang} id={`${item.id}-${i}`} /></div>)}
        </section>
      )
    }

    {
      d.cut && (
        <section class="block">
          <h2>{t('case.cut')}</h2>
          <Prose items={tr(d.cut, lang)} list />
        </section>
      )
    }

    {
      (d.artifact || has('artifact')) && (
        <section class="block">
          <h2>{t('case.artifact')}</h2>
          {d.artifact?.text && (
            <div class="artifact-text">
              <Prose items={tr(d.artifact.text, lang)} />
            </div>
          )}
          {[...visualsFor('artifact', 'before'), ...visualsFor('artifact', 'after')].map(({ v, i }) => (
            <div class="stack">
              <CaseVisual visual={v} lang={lang} id={`${item.id}-${i}`} />
            </div>
          ))}
        </section>
      )
    }

    {
      (d.outcome || has('outcome')) && (
        <section class="block">
          <h2>{d.outcome?.kind === 'plan' ? t('case.plan') : t('case.outcome')}</h2>
          {visualsFor('outcome', 'before').map(({ v, i }) => <div class="before"><CaseVisual visual={v} lang={lang} id={`${item.id}-${i}`} /></div>)}
          {d.outcome?.text && <Prose items={tr(d.outcome.text, lang)} />}
          {d.outcome?.before && d.outcome?.after && (
            <div class="ba">
              <BeforeAfter
                before={tr(d.outcome.before, lang)}
                after={tr(d.outcome.after, lang)}
                labels={{ before: t('case.before'), after: t('case.after') }}
              />
            </div>
          )}
          {visualsFor('outcome', 'after').map(({ v, i }) => <div class="after"><CaseVisual visual={v} lang={lang} id={`${item.id}-${i}`} /></div>)}
        </section>
      )
    }

    {
      d.learned && (
        <section class="block">
          <h2>{t('case.learned')}</h2>
          <Prose items={tr(d.learned, lang)} />
        </section>
      )
    }

    {
      d.next && (
        <section class="block">
          <h2>{t('case.next')}</h2>
          <Prose items={tr(d.next, lang)} />
        </section>
      )
    }

    <footer class="case-foot">
      {d.nda && <p class="nda">{t('case.nda')}</p>}
      <CopyEmail variant="block" />
    </footer>
  </article>

  {
    more.length > 0 && (
      <section class="section more">
        <h2 class="section-title">{t('case.more')}</h2>
        <div class="more-grid">
          {more.map((c, i) => (
            <ProjectCard item={c} index={i} />
          ))}
        </div>
      </section>
    )
  }
</Base>

<style>
  .case {
    max-width: 800px;
    margin-inline: auto;
    padding-bottom: 64px;
  }
  .back {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-bottom: 28px;
    padding: 6px 12px 6px 10px;
    border-radius: 12px;
    background: var(--surface);
    font-size: 13px;
    font-weight: 600;
    color: var(--text-2);
    transition: background-color 0.2s, color 0.2s;
  }
  .back:hover {
    background: var(--surface-hover);
    color: var(--text);
  }
  .eyebrow {
    font-size: 13px;
    font-weight: 600;
    color: var(--text-3);
  }
  h1 {
    margin-top: 10px;
    font-size: 40px;
    line-height: 1.1;
    font-weight: 500;
    letter-spacing: -0.01em;
  }
  .lead {
    margin-top: 14px;
    color: var(--text-3);
    max-width: 640px;
  }
  .cover {
    margin-top: 40px;
    display: grid;
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--viz-neutral);
  }
  .cover img {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }
  .glance {
    margin-top: 24px;
  }
  .block {
    padding-top: 48px;
  }
  .block h2 {
    font-size: 24px;
    font-weight: 500;
    line-height: 1.25;
    margin-bottom: 16px;
  }
  .role {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 24px;
  }
  .role h3 {
    font-size: 14px;
    font-weight: 600;
    color: var(--accent);
    margin-bottom: 8px;
  }
  .decisions {
    display: grid;
    gap: 12px;
  }
  .artifact-text {
    margin-bottom: 20px;
  }
  .stack + .stack {
    margin-top: 32px;
  }
  .before {
    margin-bottom: 20px;
  }
  .after {
    margin-top: 20px;
  }
  .ba {
    margin-top: 16px;
  }
  .case-foot {
    display: grid;
    gap: 16px;
    margin-top: 56px;
    padding-top: 32px;
    border-top: 1px solid var(--line);
  }
  .nda {
    font-size: 14px;
    color: var(--text-3);
    max-width: 640px;
  }
  .more-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 24px;
  }
  @media (max-width: 720px) {
    h1 {
      font-size: 30px;
    }
    .block {
      padding-top: 40px;
    }
    .role {
      grid-template-columns: 1fr;
      gap: 20px;
    }
    .more-grid {
      grid-template-columns: 1fr;
      gap: 32px;
    }
  }
</style>
