---
import Base from '../../layouts/Base.astro';
import ContactButton from '../../components/ContactButton.astro';
import { about, site } from '../../data/site';
import type { Lang } from '../../i18n/config';
import { localeStaticPaths, tr, useTranslations } from '../../i18n/utils';

export const getStaticPaths = localeStaticPaths;

const { lang } = Astro.props as { lang: Lang };
const t = useTranslations(lang);
const [interestsA, interestsB] = t('about.interests');
const [valuesA, valuesB] = t('about.values');
const [booksA, booksB] = t('about.books');
---

<Base title={t('about.title')}>
  <section class="intro reveal">
    <figure class="photo">
      <img class="photo-img" src={about.photo} alt={tr(site.name, lang)} width="960" height="1440" loading="eager" />
      <figcaption class:list={{ todo: tr(about.photoCaption, lang).includes('TODO') }}>{tr(about.photoCaption, lang)}</figcaption>
    </figure>
    <div class="intro-text">
      <h2 class="section-title section-title--stack">
        {tr(about.greeting, lang)}
        <span>{tr(about.headline, lang)}</span>
      </h2>
      {tr(about.paragraphs, lang).map((p) => <p class:list={{ todo: p.includes('TODO') }}>{p}</p>)}
      <div class="intro-cta">
        <ContactButton size="sm">{t('about.call')}</ContactButton>
      </div>
    </div>
  </section>

  <section class="section looking reveal" style="--i:1">
    <div>
      <h2 class="section-title">{t('about.looking')}</h2>
      {tr(about.looking, lang).map((p) => <p>{p}</p>)}
    </div>
    <div>
      <h2 class="section-title">{t('about.languages')}</h2>
      <dl class="langs">
        {
          about.languages.map((l) => (
            <div>
              <dt>{tr(l.name, lang)}</dt>
              <dd>{tr(l.level, lang)}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <section class="section">
    <h2 class="section-title">{interestsA} <span>{interestsB}</span></h2>
    <div class="chips">
      {
        about.interests.map((item, i) => (
          <span class="chip">
            <span class="dot" style={`--h:${(i * 37) % 360}`} />
            {tr(item, lang)}
          </span>
        ))
      }
    </div>
  </section>

  <section class="section">
    <h2 class="section-title section-title--stack">{valuesA} <span>{valuesB}</span></h2>
    <div class="values">
      {
        about.values.map((v) => (
          <div class="value">
            <h3>{tr(v.title, lang)}</h3>
            <p>{tr(v.text, lang)}</p>
          </div>
        ))
      }
    </div>
  </section>

  <section class="section">
    <h2 class="section-title section-title--stack">{booksA} <span>{booksB}</span></h2>
    <div class="books">
      {
        about.books.map((b) => (
          <div class="book" style={`--c:${b.color}`}>
            <span class="book-title">{b.title}</span>
            <span class="book-author">{b.author}</span>
          </div>
        ))
      }
    </div>
  </section>
</Base>

<style>
  .intro {
    display: grid;
    grid-template-columns: 5fr 7fr;
    gap: 40px;
    align-items: start;
    padding-bottom: 64px;
  }
  .photo {
    margin: 0;
  }
  .photo-img {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: 50% 15%;
    border-radius: var(--radius-lg);
    background: #111;
  }
  figcaption {
    margin-top: 10px;
    text-align: center;
    font-size: 13px;
    font-weight: 600;
    color: var(--text-3);
  }
  .intro-text {
    display: grid;
    gap: 14px;
    justify-items: start;
  }
  .intro-text p {
    color: var(--text-2);
    max-width: 600px;
  }
  .intro-text .section-title {
    margin-bottom: 8px;
  }
  .intro-cta {
    margin-top: 10px;
  }
  .section:first-of-type,
  .intro + .section {
    border-top: 1px solid var(--line);
  }

  .looking {
    display: grid;
    grid-template-columns: 7fr 5fr;
    gap: 40px;
  }
  .looking p {
    color: var(--text-2);
    max-width: 600px;
  }
  .looking p + p {
    margin-top: 12px;
  }
  .langs {
    display: grid;
    gap: 8px;
    margin: 0;
  }
  .langs div {
    display: flex;
    justify-content: space-between;
    padding: 12px 16px;
    border-radius: var(--radius-md);
    background: var(--surface);
    font-size: 14px;
    font-weight: 600;
  }
  .langs dd {
    margin: 0;
    color: var(--text-3);
  }

  .dot {
    width: 22px;
    height: 22px;
    border-radius: 6px;
    background: linear-gradient(135deg, hsl(var(--h) 70% 82%), hsl(calc(var(--h) + 40) 60% 70%));
  }

  .values {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 8px;
  }
  .value {
    padding: 16px;
    border-radius: var(--radius-md);
    background: var(--surface);
  }
  .value h3 {
    font-size: 16px;
    font-weight: 600;
    margin-bottom: 6px;
  }
  .value p {
    font-size: 14px;
    color: var(--text-3);
  }

  .books {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(140px, 168px));
    gap: 16px;
  }
  .book {
    aspect-ratio: 2 / 3;
    border-radius: 6px 12px 12px 6px;
    padding: 16px 14px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    background: var(--c);
    color: color-mix(in srgb, var(--c) 15%, white);
    box-shadow: inset 6px 0 0 rgba(0, 0, 0, 0.08), 0 6px 18px rgba(4, 17, 31, 0.08);
  }
  .book-title {
    font-size: 15px;
    font-weight: 700;
    line-height: 1.2;
  }
  .book-author {
    font-size: 12px;
    opacity: 0.8;
  }
  /* светлые обложки — тёмный текст */
  .book[style*='#e9e4dc'],
  .book[style*='#f2d64b'] {
    color: #1d1d1d;
  }

  @media (max-width: 860px) {
    .intro {
      grid-template-columns: 1fr;
      gap: 28px;
    }
    .photo {
      max-width: 420px;
    }
    .looking {
      grid-template-columns: 1fr;
      gap: 8px;
    }
    .values {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .books {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  @media (max-width: 480px) {
    .values {
      grid-template-columns: 1fr;
    }
    .books {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
