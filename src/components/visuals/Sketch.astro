---
// Эскизы для режима «A vs B» в DecisionCard и для обложек.
// Только форма, без содержания: подписи — общие слова из словаря.
//   dialogue-graph — разветвлённый граф диалога (исходный замысел)
//   three-steps    — три вопроса и результат (что запустили)
import { getLang, useTranslations } from '../../i18n/utils';

interface Props {
  kind: 'dialogue-graph' | 'three-steps';
  muted?: boolean; // отвергнутый вариант
  thumbnail?: boolean; // без подписей, для обложки
}
const { kind, muted = false, thumbnail = false } = Astro.props;
const t = useTranslations(getLang(Astro.url));
const box = muted ? 'b-muted' : 'b';
const ln = muted ? 'ln ln-muted' : 'ln';

// Граф: вопрос → два ветвления → четыре вопроса → классификация.
// Связи идут от нижнего края узла к верхнему краю следующего.
const W = 40;
const H = 22;
const graphNodes = [
  { x: 130, y: 10 },
  { x: 70, y: 62 },
  { x: 190, y: 62 },
  { x: 34, y: 114 },
  { x: 98, y: 114 },
  { x: 162, y: 114 },
  { x: 226, y: 114 },
  { x: 130, y: 172 },
];
const graphEdges = [
  [0, 1], [0, 2], [1, 3], [1, 4], [2, 5], [2, 6], [3, 7], [4, 7], [5, 7], [6, 7],
];
const bottom = (i: number) => ({ x: graphNodes[i].x + W / 2, y: graphNodes[i].y + H });
const top = (i: number) => ({ x: graphNodes[i].x + W / 2, y: graphNodes[i].y });
// Узлы закрашены фоном карточки, чтобы линии не просвечивали
const nodeFill = muted ? 'fill: var(--viz-neutral)' : 'fill: var(--viz-surface)';
---

{
  kind === 'dialogue-graph' ? (
    <svg class="viz-sketch" viewBox="0 0 300 206" aria-hidden="true">
      {graphEdges.map(([a, b]) => (
        <line x1={bottom(a).x} y1={bottom(a).y} x2={top(b).x} y2={top(b).y} class={ln} />
      ))}
      {graphNodes.map((n) => (
        <rect x={n.x} y={n.y} width={W} height={H} rx="7" class={box} style={nodeFill} />
      ))}
      {!thumbnail && (
        <g>
          <text x="176" y="25">{t('viz.sketch.question')}</text>
          <text x="236" y="77">{t('viz.sketch.branch')}</text>
          <text x="176" y="187">{t('viz.sketch.classification')}</text>
        </g>
      )}
    </svg>
  ) : (
    <svg class="viz-sketch" viewBox="0 0 300 206" aria-hidden="true">
      {[0, 1, 2].map((i) => (
        <g>
          <rect x="60" y={10 + i * 46} width="180" height="30" rx="8" class={box} />
          {!thumbnail && (
            <text x="76" y={30 + i * 46}>
              {t('viz.sketch.question')} {i + 1}
            </text>
          )}
          <line x1="150" y1={41 + i * 46} x2="150" y2={54 + i * 46} class={ln} />
        </g>
      ))}
      <rect x="60" y="148" width="180" height="40" rx="8" class={muted ? box : 'b-accent'} />
      {!thumbnail && (
        <text x="150" y="173" text-anchor="middle" style={muted ? '' : 'fill: var(--viz-accent)'}>
          {t('viz.sketch.result')}
        </text>
      )}
    </svg>
  )
}
