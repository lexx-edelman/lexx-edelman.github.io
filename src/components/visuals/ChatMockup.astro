---
// Воссозданный чат: нейтральный стиль, не похожий на конкретный продукт
import { getLang, useTranslations } from '../../i18n/utils';

interface Props {
  title: string;
  messages: { from: 'bot' | 'learner'; text: string; final?: boolean }[];
}
const { title, messages } = Astro.props;
const t = useTranslations(getLang(Astro.url));
---

<div class="chat">
  <div class="head">
    <span class="dot" aria-hidden="true"></span>
    <span>{title}</span>
  </div>
  <ol class="messages">
    {
      messages.map((m) => (
        <li class:list={['msg', m.from, { final: m.final }]}>
          <span class="who">{m.from === 'bot' ? t('viz.chat.bot') : t('viz.chat.learner')}</span>
          <span class="bubble">{m.text}</span>
        </li>
      ))
    }
  </ol>
</div>

<style>
  .chat {
    max-width: 520px;
    margin-inline: auto;
    border-radius: var(--radius-lg);
    background: var(--viz-surface);
    box-shadow: inset 0 0 0 1.5px var(--line);
    overflow: hidden;
  }
  .head {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 12px 16px;
    border-bottom: 1.5px solid var(--line);
    font-size: var(--viz-small);
    font-weight: 700;
    color: var(--text-2);
  }
  .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--viz-line);
  }
  .messages {
    list-style: none;
    margin: 0;
    padding: 16px;
    display: grid;
    gap: 12px;
  }
  .msg {
    display: grid;
    gap: 4px;
    max-width: 85%;
  }
  .learner {
    justify-self: end;
    justify-items: end;
  }
  .who {
    font-size: var(--viz-small);
    font-weight: 600;
    color: var(--text-3);
  }
  .bubble {
    padding: 10px 14px;
    border-radius: 14px;
    font-size: var(--viz-text);
    font-weight: 500;
    line-height: 1.45;
  }
  .bot .bubble {
    background: var(--viz-neutral);
    border-top-left-radius: 4px;
  }
  .learner .bubble {
    background: var(--text);
    color: var(--bg);
    border-top-right-radius: 4px;
  }
  .final .bubble {
    background: var(--viz-accent-soft);
    box-shadow: inset 0 0 0 1.5px var(--viz-accent);
  }
</style>
