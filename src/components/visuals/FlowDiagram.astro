---
// Схема процесса из массива шагов. На широком экране — в строку, на узком — столбиком.
// checkpoint — точка проверки человеком; end — внешний этап, сделанный не мной.
import { getLang, useTranslations } from '../../i18n/utils';

interface Step {
  title: string;
  note?: string;
  checkpoint?: boolean;
}
interface Props {
  steps: Step[];
  end?: { title: string; note?: string };
}
const { steps, end } = Astro.props;
const t = useTranslations(getLang(Astro.url));
const all = [...steps.map((s) => ({ ...s, external: false })), ...(end ? [{ ...end, checkpoint: false, external: true }] : [])];
---

<ol class="flow" style={`--n:${all.length}`}>
  {
    all.map((step, i) => (
      <li class:list={['step', { checkpoint: step.checkpoint, external: step.external }]}>
        <div class="box">
          <span class="title">{step.title}</span>
          {step.note && <span class="note">{step.note}</span>}
          {step.checkpoint && <span class="check">{t('viz.checkpoint')}</span>}
        </div>
        {i < all.length - 1 && <span class="arrow" aria-hidden="true" />}
      </li>
    ))
  }
</ol>

<style>
  .flow {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(var(--n), minmax(0, 1fr));
    gap: 24px;
  }
  .step {
    position: relative;
    display: flex;
  }
  .box {
    flex: 1;
    display: grid;
    align-content: start;
    gap: 6px;
    padding: 14px;
    border-radius: var(--radius-md);
    background: var(--viz-surface);
    box-shadow: inset 0 0 0 1.5px var(--line);
  }
  .checkpoint .box {
    background: var(--viz-accent-soft);
    box-shadow: inset 0 0 0 1.5px var(--viz-accent);
  }
  .external .box {
    background: none;
    box-shadow: none;
    outline: 1.5px dashed var(--viz-muted);
    outline-offset: -1.5px;
  }
  .title {
    font-size: var(--viz-text);
    font-weight: 700;
    line-height: 1.3;
  }
  .note {
    font-size: var(--viz-small);
    font-weight: 500;
    line-height: 1.4;
    color: var(--text-3);
  }
  .check {
    margin-top: 2px;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: var(--viz-small);
    font-weight: 600;
    color: var(--viz-accent);
  }
  .check::before {
    content: '';
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--viz-accent);
  }
  /* Стрелка вправо между шагами */
  .arrow {
    position: absolute;
    top: 50%;
    right: -20px;
    width: 16px;
    height: 1.5px;
    background: var(--viz-line);
  }
  .arrow::after {
    content: '';
    position: absolute;
    right: -1px;
    top: -3.25px;
    border: 4px solid transparent;
    border-left: 6px solid var(--viz-line);
    border-right: 0;
  }

  /* Узкий экран (или много шагов в узкой колонке): столбиком, стрелки вниз */
  @media (max-width: 760px) {
    .flow {
      grid-template-columns: 1fr;
      gap: 20px;
    }
    .arrow {
      top: auto;
      bottom: -16px;
      left: 24px;
      right: auto;
      width: 1.5px;
      height: 12px;
    }
    .arrow::after {
      right: auto;
      left: -3.25px;
      top: auto;
      bottom: -2px;
      border: 4px solid transparent;
      border-top: 6px solid var(--viz-line);
      border-bottom: 0;
    }
  }
</style>
