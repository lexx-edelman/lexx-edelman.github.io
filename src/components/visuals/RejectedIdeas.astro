---
// Отвергнутые идеи: приглушённо, зачёркнуто, с короткой причиной
interface Props {
  items: { title: string; reason: string }[];
}
const { items } = Astro.props;
---

<ul class="rejected">
  {
    items.map((item) => (
      <li>
        <span class="mark" aria-hidden="true">
          ×
        </span>
        <span class="body">
          <s class="title">{item.title}</s>
          <span class="reason">{item.reason}</span>
        </span>
      </li>
    ))
  }
</ul>

<style>
  .rejected {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 8px;
  }
  li {
    display: grid;
    grid-template-columns: 24px minmax(0, 1fr);
    gap: 10px;
    align-items: start;
    padding: 14px 16px;
    border-radius: var(--radius-md);
    outline: 1.5px dashed var(--viz-muted);
    outline-offset: -1.5px;
  }
  .mark {
    display: grid;
    place-items: center;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: var(--viz-muted);
    color: #fff;
    font-size: 16px;
    line-height: 1;
    font-weight: 700;
  }
  .body {
    display: grid;
    gap: 2px;
  }
  .title {
    font-size: var(--viz-text);
    font-weight: 700;
    color: var(--viz-muted-text);
    text-decoration-thickness: 1.5px;
  }
  .reason {
    font-size: var(--viz-small);
    font-weight: 600;
    color: var(--text-2);
  }
</style>
