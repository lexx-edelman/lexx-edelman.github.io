---
// Кейс 3. Выбор формата по трём критериям
import type { Lang } from '../../i18n/config';

const { lang } = Astro.props as { lang: Lang };
const L = (en: string, ru: string) => (lang === 'ru' ? ru : en);

const criteria = [
  { title: L('Depth of mastery', 'Глубина освоения'), sub: L('how well people need to know it', 'насколько глубоко нужно освоить') },
  { title: L('Completion tracking', 'Фиксация завершения'), sub: L('whether completion has to be recorded', 'нужно ли фиксировать прохождение') },
  { title: L('Frequency of use', 'Частота обращения'), sub: L('how often people come back to it', 'как часто к материалу возвращаются') },
];
const levels = ['Awareness', 'Application', 'Mastery'];
---

<svg class="dg" viewBox="0 0 760 232" role="img" aria-label={L('Format choice criteria', 'Критерии выбора формата')}>
  <defs>
    <marker id="arr-format" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
      <path d="M0,0 L10,5 L0,10 z" class="head"></path>
    </marker>
  </defs>

  {
    criteria.map((c, i) => (
      <g>
        <rect x="0" y={i * 80} width="460" height="72" rx="12" class="box" />
        <text x="18" y={i * 80 + 30} class="t">{c.title}</text>
        <text x="18" y={i * 80 + 50} class="ts">{c.sub}</text>
        <line x1="462" y1={i * 80 + 36} x2="500" y2={i * 80 + 36} class="ln" />
      </g>
    ))
  }

  <!-- Три уровня глубины -->
  {
    levels.map((level, i) => (
      <g>
        <rect x={244 + i * 72} y="22" width="66" height="28" rx="8" class="card" />
        <text x={277 + i * 72} y="40" text-anchor="middle" class="ts" style="font-size:10.5px">
          {level}
        </text>
      </g>
    ))
  }

  <line x1="500" y1="36" x2="500" y2="196" class="ln" />
  <line x1="500" y1="116" x2="548" y2="116" class="ln" marker-end="url(#arr-format)" />
  <rect x="552" y="80" width="208" height="72" rx="12" class="accent" />
  <text x="656" y="112" text-anchor="middle" class="t ta">{L('Learning format', 'Формат обучения')}</text>
  <text x="656" y="132" text-anchor="middle" class="ts">{L('chosen by the task', 'выбран под задачу')}</text>
</svg>
