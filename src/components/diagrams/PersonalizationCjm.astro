---
// Кейс 4. CJM в четыре этапа с цифровыми следами
import type { Lang } from '../../i18n/config';

const { lang } = Astro.props as { lang: Lang };
const L = (en: string, ru: string) => (lang === 'ru' ? ru : en);

const stages = [L('Choice', 'Выбор'), L('Start', 'Старт'), L('Progress', 'Прохождение'), L('Completion', 'Завершение')];
const x = (i: number) => i * 196;
---

<svg class="dg" viewBox="0 0 760 176" role="img" aria-label={L('Learner journey map', 'Карта пути сотрудника')}>
  <defs>
    <marker id="arr-cjm" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
      <path d="M0,0 L10,5 L0,10 z" class="head"></path>
    </marker>
  </defs>

  {
    stages.map((stage, i) => (
      <g>
        <rect x={x(i)} y="0" width="172" height="48" rx="12" class={i === 0 ? 'accent' : 'box'} />
        <text x={x(i) + 16} y="20" class="ts">{String(i + 1).padStart(2, '0')}</text>
        <text x={x(i) + 16} y="38" class={i === 0 ? 't ta' : 't'}>{stage}</text>
        {i < stages.length - 1 && <line x1={x(i) + 174} y1="24" x2={x(i) + 192} y2="24" class="ln" marker-end="url(#arr-cjm)" />}
        <line x1={x(i) + 86} y1="50" x2={x(i) + 86} y2="70" class="ln dash" />
        <rect x={x(i)} y="72" width="172" height="104" rx="12" class="card" />
        <text x={x(i) + 16} y="98" class="ts">{L('Digital traces', 'Цифровые следы')}</text>
        <rect x={x(i) + 16} y="112" width="140" height="48" rx="8" class="todo-box" />
        <text x={x(i) + 86} y="141" text-anchor="middle" class="todo-t">TODO</text>
      </g>
    ))
  }
</svg>
