---
// Кейс 2. Диалог тренажёра: три вопроса → итоговое сообщение → опрос об опыте
import type { Lang } from '../../i18n/config';

const { lang } = Astro.props as { lang: Lang };
const L = (en: string, ru: string) => (lang === 'ru' ? ru : en);
const xs = [0, 200, 400];
---

<svg class="dg" viewBox="0 0 760 236" role="img" aria-label={L('Trainer dialogue flow', 'Схема диалога тренажёра')}>
  <defs>
    <marker id="arr-trainer" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
      <path d="M0,0 L10,5 L0,10 z" class="head"></path>
    </marker>
  </defs>

  <text x="300" y="16" text-anchor="middle" class="ts">{L('follow-up questions are added by the platform', 'уточняющие переспросы добавляет платформа')}</text>

  {
    xs.map((x, i) => (
      <g>
        <path d={`M ${x + 52} 62 C ${x + 52} 30, ${x + 108} 30, ${x + 108} 60`} class="ln dash" marker-end="url(#arr-trainer)" />
        <rect x={x} y="64" width="160" height="92" rx="12" class="box" />
        <text x={x + 16} y="92" class="t">{L(`Question ${i + 1}`, `Вопрос ${i + 1}`)}</text>
        <rect x={x + 16} y="108" width="128" height="30" rx="8" class="card" />
        <text x={x + 80} y="128" text-anchor="middle" class="ts">{L('what to collect', 'что собираем')}</text>
        <line x1={x + 162} y1="110" x2={x + 196} y2="110" class="ln" marker-end="url(#arr-trainer)" />
      </g>
    ))
  }

  <rect x="600" y="64" width="160" height="92" rx="12" class="accent" />
  <text x="616" y="92" class="t ta">{L('Final message', 'Итоговое сообщение')}</text>
  <text x="616" y="114" class="ts">{L('learning style profile', 'профиль стиля обучения')}</text>
  <text x="616" y="132" class="ts">{L('as a starting point', 'как отправная точка')}</text>

  <line x1="680" y1="158" x2="680" y2="180" class="ln" marker-end="url(#arr-trainer)" />
  <rect x="600" y="184" width="160" height="52" rx="12" class="box" />
  <text x="616" y="206" class="t" style="font-size:12px">{L('Experience survey', 'Опрос об опыте')}</text>
  <text x="616" y="224" class="ts">{L('added after launch', 'добавлен после запуска')}</text>
</svg>
