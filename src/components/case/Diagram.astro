---
// Обёртка для любого визуала в кейсе: рамка, текстовое описание для скринридеров,
// вывод рядом с графиком, подпись и обязательная пометка об упрощении.
import { getLang, useTranslations } from '../../i18n/utils';
import { isTodo } from '../../data/cases';

interface Props {
  label: string; // описание картинки для скринридеров
  caption?: string; // подпись над пометкой об упрощении
  summary?: string; // краткий текстовый вывод (для графиков)
  illustrative?: boolean; // добавить «Данные условные»
  interactive?: boolean; // внутри есть элементы управления — не прятать их за role="img"
  bare?: boolean; // без рамки (для визуалов со своими карточками)
}
const { label, caption, summary, illustrative = false, interactive = false, bare = false } = Astro.props;
const t = useTranslations(getLang(Astro.url));
const notes = [illustrative ? t('viz.illustrative') : '', t('viz.disclaimer')].filter(Boolean).join(' ');
---

<figure class="visual">
  <div
    class:list={['frame', { bare }]}
    role={interactive ? 'group' : 'img'}
    aria-label={label}
  >
    <slot />
  </div>
  {summary && <p class="summary">{summary}</p>}
  <figcaption>
    {caption && <span class:list={['caption', { todo: isTodo(caption) }]}>{caption}</span>}
    <span class="disclaimer">{notes}</span>
  </figcaption>
</figure>

<style>
  .visual {
    margin: 0;
  }
  .visual + :global(.visual) {
    margin-top: 32px;
  }
  .frame {
    padding: 24px;
    border-radius: var(--radius-lg);
    background: var(--viz-neutral);
  }
  .frame.bare {
    padding: 0;
    background: none;
  }
  .summary {
    margin-top: 12px;
    font-size: 14px;
    color: var(--text-2);
    max-width: 640px;
  }
  figcaption {
    display: grid;
    gap: 2px;
    margin-top: 10px;
    font-size: var(--viz-small);
    font-weight: 600;
    color: var(--text-3);
  }
  .disclaimer {
    color: var(--viz-muted-text);
    font-weight: 500;
  }
  @media (max-width: 640px) {
    .frame:not(.bare) {
      padding: 16px;
    }
  }
</style>
