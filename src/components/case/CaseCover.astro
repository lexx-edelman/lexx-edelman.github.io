---
// Обложка кейса — фрагмент выдуманного интерфейса с моментом выбора.
// Шаблон и тексты — coverFragment в YAML кейса; цвет — по типу работы
// (coverType или первый тип из types). Архивные кейсы — типографическая обложка.
// Высота обложки = высота фрагмента + поля.
//
// По умолчанию показано конечное состояние (видно на скриншотах и без анимации).
// Анимация (класс .anim) проигрывается заново от начального состояния:
// на десктопе — при наведении на карточку, на телефоне и на странице кейса —
// один раз при появлении на экране. При prefers-reduced-motion анимации нет.
// Исключение — picker: при наведении переключает второй параметр и результат.
import { typesOf, type Case } from '../../data/cases';
import type { Lang } from '../../i18n/config';
import { tr, useTranslations } from '../../i18n/utils';

interface Props {
  item: Case;
  lang: Lang;
}
const { item, lang } = Astro.props;
const d = item.data;
const t = useTranslations(lang);
const L = (x: { en: string; ru: string }) => tr(x, lang);
const f = d.archived ? undefined : d.coverFragment;
const type = d.archived ? 'experience' : (d.coverType ?? d.types[0]);
const typeLabel = typesOf(item)
  .map((ct) => tr(ct.label, lang))
  .join(' · ');
---

<div class={`cover-art type-${type}`} data-cover aria-hidden="true">
  {
    f?.variant === 'task-card' && (
      <div class="frag-wrap">
        <div class="frag task">
          <span class="f-label">{L(f.label)}</span>
          <p class="f-text">{L(f.situation)}</p>
          <div class="f-buttons">
            {f.options.map((o) => (
              <span class:list={['f-btn', { accent: o.accent }]}>{L(o.text)}</span>
            ))}
          </div>
        </div>
        <p class="f-after">
          <span class="tick">✓</span> {L(f.feedback)}
        </p>
      </div>
    )
  }

  {
    f?.variant === 'chat' && (
      <div class="frag chat">
        {f.messages.map((m, i) => (
          <div class:list={['bubble', m.from, { last: i === f.messages.length - 1 }]}>
            <span class="bubble-text">{L(m.text)}</span>
            {i === f.messages.length - 1 && (
              <span class="dots">
                <i />
                <i />
                <i />
              </span>
            )}
          </div>
        ))}
      </div>
    )
  }

  {
    f?.variant === 'picker' && (
      <div class="frag picker">
        {f.params.map((p) => (
          <div class="param">
            <span class="f-label">{L(p.question)}</span>
            <span class:list={['value', { swaps: Boolean(p.alt) }]}>
              <span class="v-a">{L(p.value)}</span>
              {p.alt && <span class="v-b">{L(p.alt)}</span>}
            </span>
          </div>
        ))}
        <div class="result">
          <span class="f-label">{t('cover.result')}</span>
          <span class="swap">
            <span class="v-a">{L(f.result)}</span>
            <span class="v-b">{L(f.altResult)}</span>
          </span>
        </div>
      </div>
    )
  }

  {
    f?.variant === 'catalog-card' && (
      <div class="frag catalog">
        <div class="catalog-body">
          <span class="f-label">{L(f.meta)}</span>
          <p class="f-title">{L(f.title)}</p>
          <p class="old">
            <span class="strike">{L(f.subtitle)}</span>
          </p>
          <p class="new">
            <span class="badge">{L(f.badge)}</span>
            <span>{L(f.altSubtitle)}</span>
          </p>
        </div>
      </div>
    )
  }

  {
    f?.variant === 'review-row' && (
      <div class="frag review">
        <div class="row head">
          <span>{t('cover.question')}</span>
          <span>{t('cover.difficulty')}</span>
          <span>{t('cover.discrimination')}</span>
        </div>
        {f.rows.map((r) => (
          <div class:list={['row', { flagged: Boolean(r.flag) }]}>
            <span class="q">{L(r.question)}</span>
            <span class="num">{r.difficulty}</span>
            <span class="num">{r.discrimination}</span>
            {r.flag && <span class="flag">⚑ {L(r.flag)}</span>}
          </div>
        ))}
      </div>
    )
  }

  {
    !f && (
      <div class="typo">
        <span class="typo-title">{tr(d.title, lang)}</span>
        <span class="typo-type">{typeLabel}</span>
      </div>
    )
  }
</div>

<script>
  // Перезапуск анимации: снять класс, дать браузеру перерисовать, вернуть.
  function play(el: Element) {
    el.classList.remove('anim');
    void (el as HTMLElement).offsetWidth;
    el.classList.add('anim');
  }

  function initCovers() {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    const canHover = window.matchMedia('(hover: hover)').matches;
    const io =
      'IntersectionObserver' in window
        ? new IntersectionObserver(
            (entries, obs) =>
              entries.forEach((e) => {
                if (!e.isIntersecting) return;
                play(e.target);
                e.target.classList.add('played');
                obs.unobserve(e.target);
              }),
            { threshold: 0.6 },
          )
        : undefined;
    document.querySelectorAll<HTMLElement>('[data-cover]:not([data-ready])').forEach((el) => {
      el.dataset.ready = '1';
      const card = el.closest('a.card');
      if (card && canHover) card.addEventListener('mouseenter', () => play(el));
      else io?.observe(el);
    });
  }
  initCovers();
  document.addEventListener('astro:page-load', initCovers);
</script>

<style>
  .cover-art {
    display: grid;
    place-items: center;
    padding: 32px 28px;
    background: var(--t-bg);
    color: var(--t-ink);
  }

  .frag,
  .frag-wrap {
    width: min(100%, 440px);
    font-size: 14px;
  }
  .frag-wrap .frag {
    width: 100%;
  }
  .frag {
    display: grid;
    gap: 0.75em;
    padding: 1.15em 1.25em;
    border-radius: 1em;
    background: var(--viz-surface);
    box-shadow: 0 0.5em 1.5em rgba(4, 17, 31, 0.08);
    color: var(--text);
    text-align: left;
  }
  .f-label {
    font-size: 13px;
    font-weight: 700;
    color: var(--text-3);
  }
  .f-text {
    font-weight: 600;
    line-height: 1.4;
  }
  .f-title {
    font-size: 1.15em;
    font-weight: 700;
    line-height: 1.25;
  }
  .f-buttons {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.5em;
  }
  .f-btn {
    display: grid;
    place-items: center;
    min-height: 2.5em;
    padding: 0.45em 0.75em;
    border-radius: 0.7em;
    background: var(--surface);
    font-size: 13px;
    font-weight: 700;
    line-height: 1.2;
    text-align: center;
    white-space: nowrap;
    color: var(--text-2);
  }
  /* Выбранный вариант — по умолчанию уже «нажат» */
  .f-btn.accent {
    background: var(--t-accent);
    color: #fff;
  }
  .f-after {
    margin-top: 0.75em;
    font-size: 13px;
    font-weight: 700;
    color: var(--t-ink-2);
  }
  .tick {
    display: inline-grid;
    place-items: center;
    width: 1.5em;
    height: 1.5em;
    margin-right: 0.3em;
    border-radius: 50%;
    background: var(--t-accent);
    color: #fff;
    font-size: 0.85em;
  }

  /* --- Чат --- */
  .chat {
    gap: 0.6em;
  }
  /* Текст пузыря — блоком: анимация «печати» (clip-path) у строчного элемента
     в Chrome обрезает всё, кроме первой строки */
  .bubble-text {
    display: block;
  }
  .bubble {
    position: relative;
    max-width: 88%;
    padding: 0.6em 0.9em;
    border-radius: 1em;
    font-size: 13px;
    font-weight: 600;
    line-height: 1.4;
  }
  .bubble.bot {
    justify-self: start;
    background: var(--surface);
    border-top-left-radius: 0.3em;
  }
  .bubble.user {
    justify-self: end;
    background: var(--t-accent);
    color: #fff;
    border-top-right-radius: 0.3em;
  }
  .dots {
    position: absolute;
    left: 0;
    top: 0;
    display: flex;
    gap: 0.3em;
    padding: 0.85em 1em;
    border-radius: 1em;
    border-top-left-radius: 0.3em;
    background: var(--surface);
    opacity: 0;
  }
  .dots i {
    width: 0.4em;
    height: 0.4em;
    border-radius: 50%;
    background: var(--text-3);
  }

  /* --- Picker: два параметра в строку, результат под ними.
     Подпись и значение у обоих параметров — общие строки (subgrid),
     поэтому поля значений одной высоты, даже если текст в одном длиннее. --- */
  .picker {
    grid-template-columns: 1fr 1fr;
    grid-template-rows: auto auto auto;
    row-gap: 0.35em;
  }
  .picker .result {
    grid-column: 1 / -1;
    margin-top: 0.4em;
  }
  .param {
    display: grid;
    grid-row: span 2;
    grid-template-rows: subgrid;
  }
  .param,
  .result {
    gap: 0.35em;
  }
  .result {
    display: grid;
  }
  .param .f-label {
    align-self: end;
  }
  .value,
  .swap {
    display: grid;
  }
  .value {
    padding: 0.5em 0.8em;
    border-radius: 0.7em;
    background: var(--surface);
    font-weight: 700;
  }
  .value > *,
  .swap > * {
    grid-area: 1 / 1;
    transition:
      opacity 0.3s,
      transform 0.3s var(--ease);
  }
  .v-b {
    opacity: 0;
    transform: translateY(0.4em);
  }
  .value.swaps {
    box-shadow: inset 0 0 0 1.5px var(--t-accent);
  }
  .result {
    padding: 0.7em 0.9em;
    border-radius: 0.8em;
    background: var(--t-bg);
    color: var(--t-ink);
  }
  .result .f-label {
    color: var(--t-ink-2);
  }
  .result .swap {
    font-weight: 700;
    line-height: 1.3;
  }

  /* --- Карточка курса --- */
  .catalog {
    padding: 0;
    gap: 0;
    border-top: 0.35em solid var(--t-accent);
  }
  .catalog-body {
    display: grid;
    gap: 0.4em;
    padding: 0.9em 1.25em 1.1em;
  }
  .old {
    font-size: 13px;
    font-weight: 600;
    line-height: 1.4;
    color: var(--text-3);
  }
  /* Зачёркивание — линией-фоном, чтобы его можно было «прочертить» анимацией */
  .strike {
    background: linear-gradient(currentColor, currentColor) 0 58% / 100% 1.5px no-repeat;
  }
  .new {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35em 0.5em;
    font-size: 13px;
    font-weight: 700;
    line-height: 1.4;
    color: var(--t-ink-2);
  }
  .badge {
    padding: 0.15em 0.6em;
    border-radius: 999px;
    background: var(--t-accent);
    color: #fff;
    font-size: 13px;
    font-weight: 700;
  }

  /* --- Аналитика теста: общие колонки для всех строк --- */
  .review {
    grid-template-columns: minmax(0, 1fr) max-content max-content;
    gap: 0.25em 0;
    padding: 0.6em 0.4em;
  }
  .row {
    display: grid;
    grid-column: 1 / -1;
    grid-template-columns: subgrid;
    column-gap: 0.9em;
    align-items: center;
    padding: 0.5em 0.8em;
    border-radius: 0.6em;
    font-size: 13px;
    font-weight: 600;
  }
  .row.head {
    font-weight: 700;
    color: var(--text-3);
  }
  .row .num {
    text-align: right;
    font-variant-numeric: tabular-nums;
  }
  .row.head span:not(:first-child) {
    text-align: right;
  }
  .q {
    line-height: 1.3;
  }
  .row.flagged {
    background: color-mix(in srgb, var(--t-accent) 10%, white);
  }
  .flag {
    grid-column: 1 / -1;
    margin-top: 0.3em;
    font-weight: 700;
    color: var(--t-ink-2);
  }

  /* --- Типографическая обложка (архив) --- */
  .typo {
    display: grid;
    gap: 0.6em;
    align-self: end;
    justify-self: start;
    max-width: 85%;
  }
  .typo-title {
    font-size: 24px;
    font-weight: 600;
    line-height: 1.2;
    color: var(--t-ink);
  }
  .typo-type {
    font-size: 14px;
    font-weight: 700;
    color: var(--t-ink-2);
  }

  /* ===== Анимация: от начального состояния к конечному (.anim) ===== */
  .anim .f-btn.accent {
    animation: select 0.55s var(--ease) both;
  }
  .anim .f-after {
    animation: fade-up 0.3s 0.3s var(--ease) both;
  }
  .anim .dots {
    animation: dots 0.6s both;
  }
  .anim .bubble.last {
    animation: bubble 0.6s both;
  }
  .anim .bubble.last .bubble-text {
    animation: type 0.35s 0.25s linear both;
  }
  .anim .strike {
    animation: strike 0.3s var(--ease) both;
  }
  .anim .old {
    animation: dim 0.3s both;
  }
  .anim .new {
    animation: fade-up 0.3s 0.25s var(--ease) both;
  }
  .anim .badge {
    animation: pop 0.35s 0.3s var(--spring) both;
  }
  .anim .row.flagged {
    animation: flag-row 0.4s both;
  }
  .anim .flag {
    animation: fade-up 0.3s 0.2s var(--ease) both;
  }

  @keyframes select {
    0% {
      background: var(--viz-surface);
      color: var(--t-accent);
      box-shadow: inset 0 0 0 1.5px var(--t-accent);
    }
    45% {
      background: var(--viz-surface);
      color: var(--t-accent);
      box-shadow: inset 0 0 0 1.5px var(--t-accent);
      transform: scale(0.94);
    }
    60% {
      transform: scale(0.97);
    }
  }
  @keyframes fade-up {
    from {
      opacity: 0;
      transform: translateY(-0.3em);
    }
  }
  @keyframes dots {
    0%,
    45% {
      opacity: 1;
    }
    55%,
    100% {
      opacity: 0;
    }
  }
  @keyframes bubble {
    0%,
    40% {
      background: transparent;
    }
  }
  @keyframes type {
    from {
      clip-path: inset(0 100% 0 0);
    }
    to {
      clip-path: inset(0 0 0 0);
    }
  }
  @keyframes strike {
    from {
      background-size: 0 1.5px;
    }
  }
  @keyframes dim {
    from {
      color: var(--text-2);
    }
  }
  @keyframes pop {
    from {
      opacity: 0;
      transform: scale(0.8);
    }
  }
  @keyframes flag-row {
    from {
      background: transparent;
    }
  }

  /* Picker: при наведении переключает параметр и результат (на телефоне — .played) */
  @media (hover: hover) {
    :global(.card:hover) .swaps .v-a,
    :global(.card:hover) .swap .v-a {
      opacity: 0;
      transform: translateY(-0.4em);
    }
    :global(.card:hover) .v-b {
      opacity: 1;
      transform: none;
    }
    :global(.card:hover) .swap .v-b {
      transition-delay: 0.15s;
    }
  }
  .played .swaps .v-a,
  .played .swap .v-a {
    opacity: 0;
    transform: translateY(-0.4em);
  }
  .played .v-b {
    opacity: 1;
    transform: none;
  }
  .played .swap .v-b {
    transition-delay: 0.15s;
  }

  @media (max-width: 768px) {
    .cover-art {
      padding: 28px 20px;
    }
    /* На узком экране кнопки и параметры picker — друг под другом */
    .f-buttons {
      grid-template-columns: 1fr;
    }
    .picker {
      grid-template-columns: 1fr;
      grid-template-rows: none;
    }
    .param {
      grid-row: auto;
      grid-template-rows: none;
    }
  }
</style>
