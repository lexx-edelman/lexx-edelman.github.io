---
// Развилка: вопрос, варианты, что выбрали и почему
import { isTodo } from '../../data/cases';

interface Props {
  index: number;
  title: string;
  options: string[];
  chosen?: number;
  why: string;
  labels: { decision: string; chosen: string; why: string };
}
const { index, title, options, chosen, why, labels } = Astro.props;
const letter = (i: number) => String.fromCharCode(65 + i);
---

<article class="decision">
  <p class="num">{labels.decision} {String(index + 1).padStart(2, '0')}</p>
  <h3 class:list={{ todo: isTodo(title) }}>{title}</h3>
  <ol class="options">
    {
      options.map((option, i) => (
        <li class:list={['option', { picked: i === chosen }]}>
          <span class="letter" aria-hidden="true">{letter(i)}</span>
          <span class:list={['option-text', { todo: isTodo(option) }]}>{option}</span>
          {i === chosen && <span class="badge">{labels.chosen}</span>}
        </li>
      ))
    }
  </ol>
  <div class="why">
    <p class="why-label">{labels.why}</p>
    <p class:list={['why-text', { todo: isTodo(why) }]}>{why}</p>
  </div>
</article>

<style>
  .decision {
    padding: 24px;
    border-radius: var(--radius-lg);
    background: var(--surface);
  }
  .num {
    font-size: 13px;
    font-weight: 600;
    color: var(--text-3);
    font-variant-numeric: tabular-nums;
  }
  h3 {
    margin-top: 6px;
    font-size: 18px;
    font-weight: 600;
    line-height: 1.3;
  }
  .options {
    list-style: none;
    margin: 16px 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 8px;
  }
  .option {
    position: relative;
    display: flex;
    gap: 10px;
    align-items: flex-start;
    padding: 14px 14px 14px 12px;
    border-radius: var(--radius-md);
    background: var(--bg);
    font-size: 14px;
    color: var(--text-3);
    box-shadow: inset 0 0 0 1px var(--line);
  }
  .option.picked {
    color: var(--text);
    background: var(--accent-soft);
    box-shadow: inset 0 0 0 1.5px var(--accent);
  }
  .letter {
    flex: none;
    display: grid;
    place-items: center;
    width: 22px;
    height: 22px;
    border-radius: 7px;
    background: var(--surface);
    font-size: 12px;
    font-weight: 700;
    color: var(--text-3);
  }
  .picked .letter {
    background: var(--accent);
    color: #fff;
  }
  .option-text {
    flex: 1;
    line-height: 1.4;
  }
  .badge {
    flex: none;
    padding: 2px 8px;
    border-radius: 999px;
    background: var(--accent);
    color: #fff;
    font-size: 11px;
    font-weight: 700;
  }
  .why {
    margin-top: 16px;
  }
  .why-label {
    font-size: 13px;
    font-weight: 600;
    color: var(--text-3);
  }
  .why-text {
    margin-top: 4px;
    color: var(--text-2);
    font-size: 15px;
  }
</style>
