---
// Развилка: вопрос, варианты, что выбрали и почему.
// С эскизами (sketches) — режим «A vs B»: над каждым вариантом его схема,
// между ними пояснение. Отвергнутый вариант приглушён и обведён пунктиром.
import Sketch from '../visuals/Sketch.astro';
import { isTodo } from '../../data/cases';
import { getLang, useTranslations } from '../../i18n/utils';

interface Props {
  index: number;
  title: string;
  options: string[];
  chosen?: number;
  sketches?: ('dialogue-graph' | 'three-steps')[];
  between?: string;
  why: string;
  labels: { decision: string; chosen: string; why: string };
}
const { index, title, options, chosen, sketches, between, why, labels } = Astro.props;
const letter = (i: number) => String.fromCharCode(65 + i);
const versus = Boolean(sketches?.length);
const t = useTranslations(getLang(Astro.url));
---

<article class:list={['decision', { versus }]}>
  <p class="num">{labels.decision} {String(index + 1).padStart(2, '0')}</p>
  <h3 class:list={{ todo: isTodo(title) }}>{title}</h3>
  <ol class="options">
    {
      options.map((option, i) => (
        <li class:list={['option', { picked: i === chosen, rejected: chosen !== undefined && i !== chosen }]}>
          {sketches?.[i] && (
            <div class="sketch">
              <Sketch kind={sketches[i]} muted={chosen !== undefined && i !== chosen} />
            </div>
          )}
          <div class="option-row">
            <span class="letter" aria-hidden="true">
              {letter(i)}
            </span>
            <span class:list={['option-text', { todo: isTodo(option) }]}>{option}</span>
            {i === chosen && <span class="badge">{labels.chosen}</span>}
          </div>
        </li>
      ))
    }
  </ol>
  {between && <p class="between">{between}</p>}
  {versus && <p class="disclaimer">{t('viz.disclaimer')}</p>}
  <div class="why">
    <p class="why-label">{labels.why}</p>
    <p class:list={['why-text', { todo: isTodo(why) }]}>{why}</p>
  </div>
</article>

<style>
  .decision {
    padding: 24px;
    border-radius: var(--radius-lg);
    background: var(--viz-neutral);
  }
  .num {
    font-size: 13px;
    font-weight: 600;
    color: var(--text-3);
    font-variant-numeric: tabular-nums;
  }
  h3 {
    margin-top: 6px;
    font-size: 18px;
    font-weight: 600;
    line-height: 1.3;
  }
  .options {
    list-style: none;
    margin: 16px 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 8px;
  }
  .option {
    display: grid;
    gap: 12px;
    align-content: start;
    padding: 14px 14px 14px 12px;
    border-radius: var(--radius-md);
    background: var(--viz-surface);
    font-size: 14px;
    color: var(--text-3);
    box-shadow: inset 0 0 0 1px var(--line);
  }
  .option.picked {
    color: var(--text);
    background: var(--viz-accent-soft);
    box-shadow: inset 0 0 0 1.5px var(--viz-accent);
  }
  /* Отвергнутый вариант: приглушён, пунктирная рамка */
  .option.rejected {
    background: none;
    box-shadow: none;
    outline: 1.5px dashed var(--viz-muted);
    outline-offset: -1.5px;
    color: var(--viz-muted-text);
  }
  .sketch {
    padding: 4px 8px 0;
  }
  .versus .sketch :global(.viz-sketch) {
    max-width: 240px;
    margin-inline: auto;
  }
  .option-row {
    display: flex;
    gap: 10px;
    align-items: flex-start;
  }
  .letter {
    flex: none;
    display: grid;
    place-items: center;
    width: 22px;
    height: 22px;
    border-radius: 7px;
    background: var(--viz-neutral);
    font-size: 12px;
    font-weight: 700;
    color: var(--text-3);
  }
  .picked .letter {
    background: var(--viz-accent);
    color: #fff;
  }
  .option-text {
    flex: 1;
    line-height: 1.4;
  }
  .badge {
    flex: none;
    padding: 2px 8px;
    border-radius: 999px;
    background: var(--viz-accent);
    color: #fff;
    font-size: 11px;
    font-weight: 700;
  }
  .between {
    margin-top: 12px;
    padding: 12px 14px;
    border-left: 2px solid var(--viz-line);
    font-size: 14px;
    color: var(--text-2);
  }
  .disclaimer {
    margin-top: 8px;
    font-size: var(--viz-small);
    color: var(--viz-muted-text);
  }
  .why {
    margin-top: 16px;
  }
  .why-label {
    font-size: 13px;
    font-weight: 600;
    color: var(--text-3);
  }
  .why-text {
    margin-top: 4px;
    color: var(--text-2);
    font-size: 15px;
  }
</style>
