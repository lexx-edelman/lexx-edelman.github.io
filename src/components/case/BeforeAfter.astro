---
// Две колонки «было / стало». Содержимое — списком (before / after)
// или своей разметкой через слоты <Fragment slot="before"> и <Fragment slot="after">.
import Prose from './Prose.astro';

interface Props {
  before?: string[];
  after?: string[];
  labels: { before: string; after: string };
}
const { before, after, labels } = Astro.props;
---

<div class="ba">
  <div class="col">
    <p class="label">{labels.before}</p>
    {before ? <Prose items={before} list /> : <slot name="before" />}
  </div>
  <div class="col after">
    <p class="label">{labels.after}</p>
    {after ? <Prose items={after} list /> : <slot name="after" />}
  </div>
</div>

<style>
  .ba {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 8px;
  }
  .col {
    padding: 20px;
    border-radius: var(--radius-lg);
    background: var(--viz-neutral);
  }
  .after {
    background: var(--viz-accent-soft);
  }
  .label {
    font-size: var(--viz-small);
    font-weight: 700;
    color: var(--text-3);
    margin-bottom: 12px;
  }
  .after .label {
    color: var(--viz-accent);
  }
  @media (max-width: 600px) {
    .ba {
      grid-template-columns: 1fr;
    }
  }
</style>
