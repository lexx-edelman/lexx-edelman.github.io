---
// Карточка кейса.
// Обе раскладки лежат в общей 12-колоночной сетке главной (см. index.astro).
//   layout="row"     — крупная (featured): обложка 6 колонок, текст 6 колонок.
//   layout="compact" — обложка сверху, текст снизу (на главной — 6 колонок).
// На телефоне обе — обложка сверху, текст снизу.
// Компактная карточка занимает две строки сетки (обложка и текст) через subgrid,
// поэтому обложки в одном ряду одной высоты — по самой высокой.
import CaseCover from './case/CaseCover.astro';
import Icon from './Icon.astro';
import { isTodo, typesOf, type Case } from '../data/cases';
import { getLang, localePath, tr, useTranslations } from '../i18n/utils';

interface Props {
  item: Case;
  index?: number;
  layout?: 'compact' | 'row';
}
const { item, index = 0, layout = 'compact' } = Astro.props;
const data = item.data;
const lang = getLang(Astro.url);
const t = useTranslations(lang);
const title = tr(data.title, lang);
const summary = tr(data.summary, lang);
const tags = typesOf(item);
const sub = [tr(data.company, lang), data.year].filter(Boolean).join(' • ');
---

<a
  href={localePath(`/projects/${item.id}/`, lang)}
  class:list={['card', 'reveal', layout]}
  style={`--i:${index}`}
  data-types={data.types.join(' ')}
>
  <div class="cover" transition:name={`cover-${item.id}`}>
    {data.cover ? <img src={data.cover} alt={title} loading="lazy" /> : <CaseCover item={item} lang={lang} />}
  </div>
  <div class="info">
    <span class="eyebrow">{sub}</span>
    <span class="title">{title}</span>
    <p class:list={['summary', { todo: isTodo(summary) }]}>{summary}</p>
    <ul class="tags">
      {tags.map((type) => <li>{tr(type.short, lang)}</li>)}
    </ul>
    <span class="read">
      {t('work.read')} <Icon name="arrow-up-right" size={14} />
    </span>
  </div>
</a>

<style>
  .cover {
    position: relative;
    display: grid;
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--viz-neutral);
  }
  .cover img {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    transition: transform 0.6s var(--ease);
  }
  .card:hover .cover img {
    transform: scale(1.025);
  }

  .info {
    display: grid;
    align-content: start;
    justify-items: start;
    gap: 8px;
  }
  .eyebrow {
    font-size: 14px;
    font-weight: 600;
    color: var(--text-3);
  }
  .title {
    font-size: 20px;
    font-weight: 500;
    line-height: 1.25;
    letter-spacing: -0.005em;
    color: var(--text);
  }
  .summary {
    font-size: 15px;
    line-height: 1.45;
    color: var(--text-2);
    max-width: 560px;
  }
  .tags {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 2px 0 0;
    padding: 0;
  }
  .tags li {
    padding: 3px 9px;
    border-radius: 999px;
    background: var(--surface);
    font-size: 12px;
    font-weight: 600;
    color: var(--text-2);
  }
  .read {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    margin-top: 4px;
    font-size: 14px;
    font-weight: 600;
    color: var(--text-2);
    transition:
      color 0.2s,
      gap 0.2s var(--ease);
  }
  .card:hover .read {
    color: var(--text);
    gap: 7px;
  }

  /* --- Компактная: в сетке; две строки родительской сетки (обложка, текст) --- */
  .compact {
    display: grid;
    grid-row: span 2;
    grid-template-rows: subgrid;
    row-gap: 16px;
  }
  /* 1–2 строки описания */
  .compact .summary {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    overflow: hidden;
  }

  /* --- Крупная: колонки берёт у сетки главной, текст — от верхнего края обложки --- */
  .row {
    display: grid;
    grid-column: 1 / -1;
    grid-template-columns: subgrid;
    align-items: start;
  }
  .row .cover {
    grid-column: 1 / span 6;
  }
  .row .info {
    grid-column: 7 / -1;
  }
  .row .title {
    font-size: 26px;
    line-height: 1.2;
    letter-spacing: -0.01em;
  }
  .row .summary {
    font-size: 16px;
  }

  /* Скрытие карточки фильтром на главной */
  .card[hidden] {
    display: none;
  }

  @media (max-width: 768px) {
    .row .cover,
    .row .info {
      grid-column: 1 / -1;
    }
    .row {
      row-gap: 16px;
    }
    .row .title {
      font-size: 21px;
    }
    .row .summary {
      font-size: 15px;
    }
  }
</style>
