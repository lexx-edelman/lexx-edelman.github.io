---
// Карточка кейса на главной, в архиве и в блоке «Другие работы»
import CaseCover from './case/CaseCover.astro';
import { caseTypes, isTodo, type Case } from '../data/cases';
import { getLang, localePath, tr } from '../i18n/utils';

interface Props {
  item: Case;
  index?: number;
}
const { item, index = 0 } = Astro.props;
const data = item.data;
const lang = getLang(Astro.url);
const title = tr(data.title, lang);
const summary = tr(data.summary, lang);
const tags = caseTypes.filter((type) => data.types.includes(type.id));
const sub = [tr(data.company, lang), data.year].filter(Boolean).join(' • ');
---

<a
  href={localePath(`/projects/${item.id}/`, lang)}
  class="card reveal"
  style={`--i:${index}`}
  data-types={data.types.join(' ')}
>
  <div class="cover" transition:name={`cover-${item.id}`}>
    {data.cover ? <img src={data.cover} alt={title} loading="lazy" /> : <CaseCover item={item} lang={lang} />}
  </div>
  <div class="meta">
    <span class="title">{title}</span>
    <span class="sub">{sub}</span>
  </div>
  <p class:list={['summary', { todo: isTodo(summary) }]}>{summary}</p>
  <ul class="tags">
    {tags.map((type) => <li>{tr(type.short, lang)}</li>)}
  </ul>
</a>

<style>
  .card {
    display: block;
  }
  .cover {
    position: relative;
    aspect-ratio: 4 / 3;
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--viz-neutral);
  }
  .cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s var(--ease);
  }
  .cover :global(.cover-art) {
    transition: transform 0.6s var(--ease);
  }
  .card:hover .cover img,
  .card:hover .cover :global(.cover-art) {
    transform: scale(1.025);
  }

  .meta {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    margin-top: 12px;
    font-size: 14px;
    font-weight: 600;
    color: var(--text-3);
  }
  .title {
    transition: color 0.2s;
  }
  .card:hover .title {
    color: var(--text);
  }
  .sub {
    flex: none;
    max-width: 50%;
    text-align: right;
  }
  .summary {
    margin-top: 6px;
    font-size: 14px;
    line-height: 1.45;
    color: var(--text-3);
    max-width: 520px;
  }
  .tags {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 10px 0 0;
    padding: 0;
  }
  .tags li {
    padding: 3px 9px;
    border-radius: 999px;
    background: var(--surface);
    font-size: 12px;
    font-weight: 600;
    color: var(--text-2);
  }
  /* Скрытие карточки фильтром на главной */
  .card[hidden] {
    display: none;
  }
  @media (max-width: 520px) {
    .meta {
      flex-direction: column;
      gap: 2px;
    }
    .sub {
      max-width: none;
      text-align: left;
      font-weight: 500;
    }
  }
</style>
