---
import { site } from '../data/site';
import { getLang, tr } from '../i18n/utils';

interface Props {
  size?: number;
}
const { size = 60 } = Astro.props;
const name = tr(site.name, getLang(Astro.url));
---

<span class="avatar" style={`--size:${size}px`}>
  {site.avatar ? <img src={site.avatar} alt={name} width={size} height={size} /> : <span>{site.initials}</span>}
</span>

<style>
  .avatar {
    position: relative;
    display: grid;
    place-items: center;
    width: var(--size);
    height: var(--size);
    flex: none;
    border-radius: calc(var(--size) * 0.28);
    overflow: hidden;
    background: linear-gradient(135deg, #dfe4ff, #f6dcef);
    box-shadow: 0 1px 2px rgba(4, 17, 31, 0.06);
    color: #3b4a7a;
    font-weight: 700;
    font-size: calc(var(--size) * 0.32);
    letter-spacing: 0.02em;
  }
  /* Светлая рамка поверх фото */
  .avatar::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    box-shadow: inset 0 0 0 2px rgba(255, 255, 255, 0.8);
    pointer-events: none;
  }
  img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>
